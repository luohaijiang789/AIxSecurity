{
  "rules": [
    {
      "id": "aix.java.sqli.taint",
      "languages": [
        "java"
      ],
      "severity": "WARNING",
      "message": "Request-controlled data reaches SQL text; independent review required.",
      "mode": "taint",
      "pattern-sources": [
        {
          "pattern-either": [
            {
              "pattern": "$REQ.getParameter(...)"
            },
            {
              "pattern": "$REQ.getParameterValues(...)"
            },
            {
              "pattern": "$REQ.getHeader(...)"
            },
            {
              "pattern": "$REQ.getHeaders(...)"
            },
            {
              "pattern": "$REQ.getQueryString(...)"
            }
          ]
        }
      ],
      "pattern-sinks": [
        {
          "patterns": [
            {
              "pattern-either": [
                {
                  "pattern": "$STMT.executeQuery($SQL, ...)"
                },
                {
                  "pattern": "$STMT.executeUpdate($SQL, ...)"
                },
                {
                  "pattern": "$STMT.execute($SQL, ...)"
                },
                {
                  "pattern": "$CONN.prepareStatement($SQL, ...)"
                },
                {
                  "pattern": "$EM.createQuery($SQL, ...)"
                },
                {
                  "pattern": "$EM.createNativeQuery($SQL, ...)"
                }
              ]
            },
            {
              "focus-metavariable": "$SQL"
            }
          ]
        }
      ],
      "pattern-sanitizers": [
        {
          "pattern": "Integer.parseInt(...)"
        },
        {
          "pattern": "Long.parseLong(...)"
        }
      ]
    },
    {
      "id": "aix.java.asset.source",
      "languages": [
        "java"
      ],
      "severity": "INFO",
      "message": "Java source observation",
      "pattern-either": [
        {
          "pattern": "$REQ.getParameter(...)"
        },
        {
          "pattern": "$REQ.getParameterValues(...)"
        },
        {
          "pattern": "$REQ.getHeader(...)"
        },
        {
          "pattern": "$REQ.getHeaders(...)"
        },
        {
          "pattern": "$REQ.getQueryString(...)"
        }
      ]
    },
    {
      "id": "aix.java.asset.sink",
      "languages": [
        "java"
      ],
      "severity": "INFO",
      "message": "Java sink observation",
      "pattern-either": [
        {
          "pattern": "$STMT.executeQuery($SQL, ...)"
        },
        {
          "pattern": "$STMT.executeUpdate($SQL, ...)"
        },
        {
          "pattern": "$STMT.execute($SQL, ...)"
        },
        {
          "pattern": "$CONN.prepareStatement($SQL, ...)"
        },
        {
          "pattern": "$EM.createQuery($SQL, ...)"
        },
        {
          "pattern": "$EM.createNativeQuery($SQL, ...)"
        },
        {
          "pattern": "Runtime.getRuntime().exec($COMMAND, ...)"
        },
        {
          "pattern": "new ProcessBuilder(\"sh\", \"-c\", $COMMAND).start()"
        },
        {
          "pattern": "new ProcessBuilder(\"/bin/sh\", \"-c\", $COMMAND).start()"
        },
        {
          "pattern": "new ProcessBuilder(\"bash\", \"-c\", $COMMAND).start()"
        },
        {
          "pattern": "new ProcessBuilder(\"/bin/bash\", \"-c\", $COMMAND).start()"
        },
        {
          "pattern": "new FileInputStream($PATH)"
        },
        {
          "pattern": "new FileOutputStream($PATH, ...)"
        },
        {
          "pattern": "new RandomAccessFile($PATH, ...)"
        },
        {
          "pattern": "Files.readAllBytes($PATH)"
        },
        {
          "pattern": "Files.readString($PATH, ...)"
        },
        {
          "pattern": "Files.newInputStream($PATH, ...)"
        },
        {
          "pattern": "Files.newBufferedReader($PATH, ...)"
        },
        {
          "pattern": "Files.newOutputStream($PATH, ...)"
        },
        {
          "pattern": "Files.write($PATH, ...)"
        },
        {
          "pattern": "Files.writeString($PATH, ...)"
        },
        {
          "pattern": "(Runtime $R).exec($COMMAND, ...)"
        },
        {
          "pattern": "(java.lang.Runtime $R).exec($COMMAND, ...)"
        },
        {
          "pattern": "java.lang.Runtime.getRuntime().exec($COMMAND, ...)"
        },
        {
          "pattern": "new java.io.FileInputStream($PATH)"
        },
        {
          "pattern": "new java.io.FileOutputStream($PATH, ...)"
        },
        {
          "pattern": "new java.io.RandomAccessFile($PATH, ...)"
        },
        {
          "pattern": "java.nio.file.Files.readAllBytes($PATH)"
        },
        {
          "pattern": "java.nio.file.Files.readString($PATH, ...)"
        },
        {
          "pattern": "java.nio.file.Files.newInputStream($PATH, ...)"
        },
        {
          "pattern": "java.nio.file.Files.newBufferedReader($PATH, ...)"
        },
        {
          "pattern": "java.nio.file.Files.newOutputStream($PATH, ...)"
        },
        {
          "pattern": "java.nio.file.Files.write($PATH, ...)"
        },
        {
          "pattern": "java.nio.file.Files.writeString($PATH, ...)"
        }
      ]
    },
    {
      "id": "aix.java.asset.guard",
      "languages": [
        "java"
      ],
      "severity": "INFO",
      "message": "Java guard observation",
      "pattern-either": [
        {
          "pattern": "$PSTMT.setString(...)"
        },
        {
          "pattern": "$PSTMT.setInt(...)"
        },
        {
          "pattern": "Integer.parseInt(...)"
        }
      ]
    },
    {
      "id": "aix.java.asset.entry",
      "languages": [
        "java"
      ],
      "severity": "INFO",
      "message": "Java entry observation",
      "pattern-either": [
        {
          "pattern": "public void doGet(...) { ... }"
        },
        {
          "pattern": "public void doPost(...) { ... }"
        }
      ]
    },
    {
      "id": "aix.java.command-injection.taint",
      "languages": [
        "java"
      ],
      "severity": "WARNING",
      "message": "Request-controlled command input reaches process execution. Runtime.exec may imply argument/executable injection rather than shell interpretation; independent review required.",
      "mode": "taint",
      "pattern-sources": [
        {
          "pattern-either": [
            {
              "pattern": "$REQ.getParameter(...)"
            },
            {
              "pattern": "$REQ.getParameterValues(...)"
            },
            {
              "pattern": "$REQ.getHeader(...)"
            },
            {
              "pattern": "$REQ.getHeaders(...)"
            },
            {
              "pattern": "$REQ.getQueryString(...)"
            }
          ]
        }
      ],
      "pattern-sinks": [
        {
          "patterns": [
            {
              "pattern-either": [
                {
                  "pattern": "Runtime.getRuntime().exec($COMMAND, ...)"
                },
                {
                  "pattern": "new ProcessBuilder(\"sh\", \"-c\", $COMMAND).start()"
                },
                {
                  "pattern": "new ProcessBuilder(\"/bin/sh\", \"-c\", $COMMAND).start()"
                },
                {
                  "pattern": "new ProcessBuilder(\"bash\", \"-c\", $COMMAND).start()"
                },
                {
                  "pattern": "new ProcessBuilder(\"/bin/bash\", \"-c\", $COMMAND).start()"
                },
                {
                  "pattern": "(Runtime $R).exec($COMMAND, ...)"
                },
                {
                  "pattern": "(java.lang.Runtime $R).exec($COMMAND, ...)"
                },
                {
                  "pattern": "java.lang.Runtime.getRuntime().exec($COMMAND, ...)"
                }
              ]
            },
            {
              "focus-metavariable": "$COMMAND"
            }
          ]
        }
      ]
    },
    {
      "id": "aix.java.path-traversal.taint",
      "languages": [
        "java"
      ],
      "severity": "WARNING",
      "message": "Request-controlled path reaches file I/O; confinement, permissions and normalization require independent review.",
