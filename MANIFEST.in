include README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md Makefile .env.example
recursive-include docs *.md
recursive-include scripts *.py
recursive-include tests *.py
global-exclude *.pyc .DS_Store
prune runs
prune .venv

recursive-include src/aixsecurity/entrypoints/static *.html *.js *.css
recursive-include src/aixsecurity/rules *.json
